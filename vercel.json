{
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node"
    },
    "api/paystack/webhook.ts": {
      "runtime": "@vercel/node",
      "memory": 512,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}

