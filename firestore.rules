rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }
    function driverPath() {
      return /databases/$(database)/documents/drivers/$(request.auth.uid);
    }
    function isDriver() {
      return isSignedIn() && exists(driverPath());
    }

    // Structural guard for config/pricing: low tier must always undercut
    // standard, surge must always exceed it. Applied everywhere a write to
    // that doc could land (including the admin catch-all below), since
    // Firestore combines overlapping match blocks with OR — a rule added
    // only to the specific /config/pricing block would otherwise be
    // bypassed by the broader admin rule.
    function isValidPricingTier(tier) {
      return tier == 'low' || tier == 'standard' || tier == 'surge';
    }
    function isValidPricingWrite(data) {
      return isValidPricingTier(data.activeTier)
        && data.lowMultiplier is number && data.lowMultiplier > 0 && data.lowMultiplier < 1.0
        && data.surgeMultiplier is number && data.surgeMultiplier > 1.0;
    }
    function isPricingDoc(pathSegments) {
      return pathSegments[0] == 'config' && pathSegments[1] == 'pricing';
    }

    // Admin can do everything (web admin dashboard)
    match /{document=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && (!isPricingDoc(document) || isValidPricingWrite(request.resource.data));
      allow delete: if isAdmin();
    }

    // Public config
    match /config/pricing {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPricingWrite(request.resource.data);
      allow delete: if isAdmin();
    }

    // Store catalog — public read; admin writes (also covered by the catch-all).
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Profiles — customers and admins only (never drivers)
    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.role != 'driver';
      allow update: if isOwner(userId)
        && request.resource.data.role != 'driver';
      allow delete: if false;
    }

    function validPriority(value) {
      return value is int && value >= 0 && value <= 100;
    }

    function resultingPriorityOk() {
      return !('priority' in request.resource.data)
        || validPriority(request.resource.data.priority);
    }

    // Drivers — own doc only; approval via admin
    match /drivers/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'driver'
        && request.resource.data.status == 'pending'
        && request.resource.data.priority == 100;
      allow update: if resultingPriorityOk()
        && (
          isAdmin()
          || (isOwner(userId) && isDriver()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['expoPushToken', 'pushTokenUpdatedAt', 'updatedAt', 'name', 'phone', 'photoURL', 'notificationsEnabled']))
        );
      allow delete: if false;
    }

    // Store orders (physical goods) — customers own their docs.
    // Separate from bookings: waste-collection jobs must not reuse this schema.
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Bookings — customers own their docs; assigned drivers may read only.
    // Split allow statements so list queries can prove one complete condition
    // (OR + get() inside a single allow is rejected for collection queries).
    match /bookings/{bookingId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get, list: if isSignedIn() && resource.data.driverId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    // Subscriptions — users can read and manage their own
    match /subscriptions/{subscriptionId} {
      allow read, update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Referrals — users can read and create their own
    match /referrals/{referralId} {
      allow read, update: if isSignedIn()
        && (resource.data.referrerUserId == request.auth.uid
          || resource.data.referredUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.referredUserId == request.auth.uid;
      allow delete: if false;
    }

    // Jobs — assigned drivers may read only. Status transitions go through
    // Cloud Functions / Admin SDK API routes, not client writes.
    match /jobs/{jobId} {
      allow get, list: if isSignedIn() && resource.data.assignedTo == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Driver shift sessions — queryable online-time history (not RTDB presence).
    // List queries must include driverId == request.auth.uid so they satisfy this rule.
    match /driverShiftSessions/{sessionId} {
      allow get, list: if isSignedIn() && resource.data.driverId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt', 'durationMs']);
      allow delete: if false;
    }
  }
}
