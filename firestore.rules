rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }
    function driverPath() {
      return /databases/$(database)/documents/drivers/$(request.auth.uid);
    }
    function isDriver() {
      return isSignedIn() && exists(driverPath());
    }
    function isApprovedDriver() {
      return isDriver()
        && (get(driverPath()).data.status == 'approved'
          || get(driverPath()).data.isActive == true);
    }

    // Admin can do everything (web admin dashboard)
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public config
    match /config/pricing {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Profiles — customers and admins only (never drivers)
    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.role != 'driver';
      allow update: if isOwner(userId)
        && request.resource.data.role != 'driver';
      allow delete: if false;
    }

    function validPriority(value) {
      return value is int && value >= 0 && value <= 100;
    }

    function resultingPriorityOk() {
      return !('priority' in request.resource.data)
        || validPriority(request.resource.data.priority);
    }

    // Drivers — own doc only; approval via admin
    match /drivers/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'driver'
        && request.resource.data.status == 'pending'
        && request.resource.data.priority == 100;
      allow update: if resultingPriorityOk()
        && (
          isAdmin()
          || (isOwner(userId) && isDriver()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['expoPushToken', 'pushTokenUpdatedAt', 'updatedAt', 'name', 'phone']))
        );
      allow delete: if false;
    }

    // Bookings — customers own their docs; assigned drivers may read only.
    // Driver status transitions go through Cloud Functions (Admin SDK).
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || (isApprovedDriver() && resource.data.driverId == request.auth.uid));
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    // Subscriptions — users can read and manage their own
    match /subscriptions/{subscriptionId} {
      allow read, update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Referrals — users can read and create their own
    match /referrals/{referralId} {
      allow read, update: if isSignedIn()
        && (resource.data.referrerUserId == request.auth.uid
          || resource.data.referredUserId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.referredUserId == request.auth.uid;
      allow delete: if false;
    }

    // Jobs — API (Admin SDK) only, no client access
    match /jobs/{jobId} {
      allow read, write: if false;
    }

    // Driver shift sessions — queryable online-time history (not RTDB presence).
    // List queries must include driverId == request.auth.uid so they satisfy this rule.
    match /driverShiftSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.driverId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt', 'durationMs']);
      allow delete: if false;
    }
  }
}
