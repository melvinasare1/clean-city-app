rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /driver-photos/{fileName} {
      allow read: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /job-photos/{jobId}/{fileName} {
      allow read: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.assignedTo == request.auth.uid;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.assignedTo == request.auth.uid
        && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.jobStatus == 'in_progress'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
