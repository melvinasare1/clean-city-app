{
  "name": "clean-city-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "driver": "npm run start --workspace=apps/driver",
    "customer": "npm run start --workspace=apps/customer",
    "driver:web": "npm run web --workspace=apps/driver",
    "customer:web": "npm run web --workspace=apps/customer",
    "eas:driver:ios:dev": "npm run eas:ios:dev --workspace=apps/driver",
    "eas:customer:ios:dev": "npm run eas:ios:dev --workspace=apps/customer",
    "eas:driver:ios:prod": "npm run eas:ios:prod --workspace=apps/driver",
    "eas:customer:ios:prod": "npm run eas:ios:prod --workspace=apps/customer",
    "eas:driver:android:prod": "npm run eas:android:prod --workspace=apps/driver",
    "eas:customer:android:prod": "npm run eas:android:prod --workspace=apps/customer",
    "eas:driver:prod": "npm run eas:prod --workspace=apps/driver",
    "eas:customer:prod": "npm run eas:prod --workspace=apps/customer",
    "seed:pricing": "cd functions && node ../scripts/seed-pricing-config.js",
    "seed:pricing:dry-run": "cd functions && node ../scripts/seed-pricing-config.js --dry-run",
    "seed:products": "cd functions && node ../scripts/seed-products.js",
    "seed:products:dry-run": "cd functions && node ../scripts/seed-products.js --dry-run",
    "deploy:firestore-rules": "node scripts/deploy-firestore-rules.js",
    "deploy:database-rules": "node scripts/deploy-database-rules.js",
    "mapbox:directions-usage": "node scripts/check-mapbox-directions-usage.js"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0"
  },
  "devDependencies": {
    "@vercel/node": "^13.0.1"
  },
  "overrides": {
    "expo-constants": "18.0.12",
    "expo-font": "14.0.12"
  }
}
